# HTTP headers for static hosts that read this file (Cloudflare Pages, Netlify).
# Cloudflare is the documented deployment direction (OD-004); if the final host
# differs, these rules must be translated to its own configuration format.

/*
  # Clickjacking and MIME-sniffing protection.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Deny hardware APIs this site never uses. Also an ad-tech surface reducer.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  # HSTS. Only meaningful once the domain is served over HTTPS everywhere.
  # Add `preload` and submit the domain only when you are certain every
  # subdomain can stay on HTTPS permanently; preload removal is slow.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed build assets never change under the same name, so they can be cached
# indefinitely. This is the single biggest repeat-visit performance win.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry document must always be revalidated, otherwise a cached index.html
# keeps pointing at asset hashes that no longer exist after a deploy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/og-image.png
  Cache-Control: public, max-age=604800
