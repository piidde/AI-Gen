# Browser-safe Supabase configuration. Never put a service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Browser UI gate only. Configure the Discord Client ID and secret in Supabase
# Auth first; this value must never contain either credential.
VITE_AUTH_DISCORD_ENABLED=false

# --- Site and search visibility ---------------------------------------------

# Canonical public origin, without a trailing slash. Drives canonical URLs,
# Open Graph URLs, robots.txt and sitemap.xml.
VITE_SITE_ORIGIN=https://takewing.ai

# Search indexing is opt-in. Leave unset or "false" for local, preview and demo
# builds: those publish fictional prices and no live service, so indexing them
# would put unverified pricing into search results. Set to "true" only on a
# deployment that serves a real, verified offering.
#
# The effect of "true": pages marked indexable emit `index, follow`, robots.txt
# allows crawling, the sitemap lists public URLs, and JSON-LD is emitted.
VITE_SITE_INDEXABLE=false

# --- Analytics and advertising ----------------------------------------------
# Both are optional. Leave unset and no third-party tag loads at all, and the
# consent banner stays hidden. Tags never load before the visitor consents.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Google Ads conversion ID, e.g. AW-XXXXXXXXX
VITE_ADS_CONVERSION_ID=
