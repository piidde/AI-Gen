{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "takewing-api",
  "account_id": "0fad9dab48065d8592142ec0dd02bfe1",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/healthz", "/v1/*", "/stripe/webhook"]
  },
  "vars": {
    "MAX_REQUEST_BYTES": "1048576",
    "MAX_TEXT_RESULT_BYTES": "8388608",
    "MAX_RESULT_BYTES": "268435456",
    "ALLOWED_ORIGINS": "https://aiapi.deals",
    "PUBLIC_SITE_URL": "https://aiapi.deals",
    "SUPABASE_URL": "https://pwaiidpiymmeppxebfjd.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ei5kOG-ZzeA-cE43s_fuxw_dhEGqBTe"
  },
  "routes": [{ "pattern": "aiapi.deals", "custom_domain": true }],
  "r2_buckets": [
    {
      "binding": "GENERATED_ASSETS",
      "bucket_name": "takewing-generated-assets"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "MEDIA_QUEUE", "queue": "takewing-media" }
    ],
    "consumers": [
      {
        "queue": "takewing-media",
        "max_batch_size": 1,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "takewing-media-dlq",
        "max_concurrency": 4
      }
    ]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 0.25 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "env": {
    "staging": {
      "name": "takewing-api-staging",
      "vars": {
        "MAX_REQUEST_BYTES": "1048576",
        "MAX_TEXT_RESULT_BYTES": "8388608",
        "MAX_RESULT_BYTES": "268435456",
        "ALLOWED_ORIGINS": "http://localhost:5173"
      },
      "r2_buckets": [
        {
          "binding": "GENERATED_ASSETS",
          "bucket_name": "takewing-generated-assets-staging"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "MEDIA_QUEUE", "queue": "takewing-media-staging" }
        ],
        "consumers": [
          {
            "queue": "takewing-media-staging",
            "max_batch_size": 1,
            "max_batch_timeout": 2,
            "max_retries": 3,
            "retry_delay": 60,
            "dead_letter_queue": "takewing-media-staging-dlq",
            "max_concurrency": 2
          }
        ]
      }
    }
  }
}
